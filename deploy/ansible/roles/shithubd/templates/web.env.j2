# Managed by Ansible — 0600, owned by {{ shithub_user }}.
# Sourced by shithubd-web.service via EnvironmentFile=.
#
# Secrets are pulled from sops/1Password at deploy time and never
# committed. The Jinja `{{ ... }}` references resolve from the
# inventory + the operator's secret store.

SHITHUB_DATABASE_URL=postgresql://shithub:{{ shithub_db_password }}@127.0.0.1:5432/shithub?sslmode=disable
SHITHUB_BASE_URL=https://{{ shithub_domain }}
SHITHUB_SITE_NAME=shithub
SHITHUB_EMAIL_FROM={{ shithub_email_from }}
SHITHUB_EMAIL_BACKEND={{ shithub_email_backend }}
SHITHUB_LISTEN_ADDR=127.0.0.1:8080
SHITHUB_REPOS_ROOT={{ shithub_data_root }}/repos
SHITHUB_TMP_ROOT={{ shithub_data_root }}/tmp

# Session + AEAD keys (32-byte base64). Operator mints once and
# rotates per the runbook.
SHITHUB_SESSION_KEY={{ shithub_session_key_b64 }}
SHITHUB_TOTP_KEY={{ shithub_totp_key_b64 }}

# Postmark transactional sender; DKIM/SPF configured before deploy.
{% if shithub_email_backend == "postmark" %}
SHITHUB_POSTMARK_SERVER_TOKEN={{ shithub_postmark_token }}
{% endif %}
