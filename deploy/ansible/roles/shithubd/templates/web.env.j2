# Managed by Ansible — 0600, owned by {{ shithub_user }}.
# Sourced by shithubd-web.service via EnvironmentFile=.
#
# Naming contract: shithubd's config loader maps env vars by
# joining the TOML path with double underscores between segments
# (e.g., auth.email_from -> SHITHUB_AUTH__EMAIL_FROM). A handful
# of single-underscore names (SHITHUB_DATABASE_URL, SHITHUB_SESSION_KEY,
# SHITHUB_TOTP_KEY) are explicit aliases. Misnamed env vars are
# silently ignored — the binary falls back to defaults, which sends
# email to stdout instead of via Postmark. Match docs/internal/config.md
# for the canonical key names.

SHITHUB_DATABASE_URL=postgresql://shithub:{{ shithub_db_password }}@127.0.0.1:5432/shithub?sslmode=disable
SHITHUB_WEB__ADDR=127.0.0.1:8080

# Loopback-only pprof listener. Separate http.Server, never mounted on
# the main router, and shithubd refuses to start if this resolves to
# anything but a loopback IP — so Caddy cannot proxy to it and nothing
# off-box can reach it. Costs a goroutine and a socket; buys a heap
# profile during the next incident instead of a guess (2026-09-02
# availability sitrep, root cause #12).
SHITHUB_WEB__PPROF_ADDR={{ shithub_pprof_addr | default("127.0.0.1:6060") }}
# Caddy reverse-proxies from loopback and appends the client to
# X-Forwarded-For. Without a trust list shithubd keys every
# anonymous request on 127.0.0.1, so one crawler exhausts the
# shared anon rate-limit bucket and everyone else — including the
# uptime probe — gets 429. The value below matches the built-in
# default and is written out documentarily; change it only if a
# non-loopback proxy (an LB on a private network) fronts the app.
SHITHUB_WEB__TRUSTED_PROXIES=127.0.0.0/8,::1/128

# auth surface
SHITHUB_AUTH__BASE_URL=https://{{ shithub_domain }}
SHITHUB_AUTH__SITE_NAME=shithub
SHITHUB_AUTH__EMAIL_FROM={{ shithub_email_from }}
SHITHUB_AUTH__EMAIL_BACKEND={{ shithub_email_backend }}

# SSH-git surface. Enabled flips the SSH clone URL on repo pages.
# The actual SSH service is sshd's Match-User-git block (see
# deploy/sshd_config.j2) calling shithubd's ssh-authkeys + ssh-shell
# subcommands. Both layers must be in place — toggling Enabled with
# no sshd config gives users an SSH URL that 5xx's at connect.
SHITHUB_AUTH__SSH__ENABLED=true
SHITHUB_AUTH__SSH__HOST=git@{{ shithub_domain }}

# storage
SHITHUB_STORAGE__REPOS_ROOT={{ shithub_data_root }}/repos
{% if s3_bucket | default("") %}
# DigitalOcean Spaces runtime bucket via its S3-compatible API.
SHITHUB_STORAGE__S3__ENDPOINT={{ s3_endpoint }}
SHITHUB_STORAGE__S3__REGION={{ s3_region | default("us-east-1") }}
SHITHUB_STORAGE__S3__ACCESS_KEY_ID={{ s3_access_key_id }}
SHITHUB_STORAGE__S3__SECRET_ACCESS_KEY={{ s3_secret_access_key }}
SHITHUB_STORAGE__S3__BUCKET={{ s3_bucket }}
SHITHUB_STORAGE__S3__USE_SSL={{ (s3_use_ssl | default(true)) | ternary("true", "false") }}
SHITHUB_STORAGE__S3__FORCE_PATH_STYLE={{ (s3_force_path_style | default(false)) | ternary("true", "false") }}
{% endif %}

# AEAD keys (32-byte base64). Aliased single-underscore names.
SHITHUB_SESSION_KEY={{ shithub_session_key_b64 }}
SHITHUB_TOTP_KEY={{ shithub_totp_key_b64 }}
{% if shithub_webhook_aead_key_b64 | default("") %}
# Dedicated webhook secret AEAD key. Independent of TOTP key so a
# TOTP rotation doesn't also rotate webhook secret encryption. When
# this key is set, OpenSecret tries it first and falls back to
# SHITHUB_TOTP_KEY for un-migrated rows; run
# `shithubd admin re-encrypt-webhooks` to migrate.
SHITHUB_WEBHOOK__AEAD_KEY={{ shithub_webhook_aead_key_b64 }}
{% endif %}

# HTML rate-limit budgets (F02). Token-bucket front for the public
# HTML chi group. Anonymous browsers (keyed by remote IP) and
# authenticated browsers (keyed by user id) get distinct budgets;
# site admins bypass entirely. Static, health, probes, /api/v1
# (its own limiter) and /stripe/webhook are NOT rate-limited.
# Defaults below match the F02 sprint table; the binary applies
# the same defaults when the env vars are unset, so leaving these
# alone is safe.
SHITHUB_RATELIMIT__HTML__ANON_BURST={{ shithub_ratelimit_html_anon_burst | default(60) }}
SHITHUB_RATELIMIT__HTML__ANON_REFILL_PER_SEC={{ shithub_ratelimit_html_anon_refill | default(1) }}
SHITHUB_RATELIMIT__HTML__AUTHED_BURST={{ shithub_ratelimit_html_authed_burst | default(600) }}
SHITHUB_RATELIMIT__HTML__AUTHED_REFILL_PER_SEC={{ shithub_ratelimit_html_authed_refill | default(10) }}

# Transactional email credentials. DKIM/SPF for the chosen provider
# must be configured at the DNS layer before deploy.
{% if shithub_email_backend == "postmark" %}
SHITHUB_AUTH__POSTMARK__SERVER_TOKEN={{ shithub_postmark_token }}
{% elif shithub_email_backend == "resend" %}
SHITHUB_AUTH__RESEND__API_KEY={{ shithub_resend_api_key }}
{% endif %}

{% if billing_stripe_secret_key | default("") %}
# Stripe billing (Pro + Team). Empty/unset = billing routes do not
# mount; existing local state remains in the DB. See
# docs/internal/runbooks/stripe-billing.md for setup + rollback.
SHITHUB_BILLING__ENABLED=true
SHITHUB_BILLING__GRACE_PERIOD={{ billing_grace_period | default("336h") }}
SHITHUB_BILLING__STRIPE__SECRET_KEY={{ billing_stripe_secret_key }}
SHITHUB_BILLING__STRIPE__WEBHOOK_SECRET={{ billing_stripe_webhook_secret }}
SHITHUB_BILLING__STRIPE__TEAM_PRICE_ID={{ billing_stripe_team_price_id }}
SHITHUB_BILLING__STRIPE__PRO_PRICE_ID={{ billing_stripe_pro_price_id }}
SHITHUB_BILLING__STRIPE__AUTOMATIC_TAX={{ (billing_stripe_automatic_tax | default(false)) | ternary("true", "false") }}
# Per-feature enforce flags ship report-only (false). Flip per feature
# after 7 days of clean entitlements.report_only_deny telemetry.
SHITHUB_BILLING__ENFORCE__USER_REQUIRED_REVIEWERS={{ (billing_enforce_user_required_reviewers | default(false)) | ternary("true", "false") }}
SHITHUB_BILLING__ENFORCE__USER_ADVANCED_BRANCH_PROTECTION={{ (billing_enforce_user_advanced_branch_protection | default(false)) | ternary("true", "false") }}
SHITHUB_BILLING__ENFORCE__USER_PROFILE_PINS_BEYOND_FREE={{ (billing_enforce_user_profile_pins_beyond_free | default(false)) | ternary("true", "false") }}
{% endif %}
