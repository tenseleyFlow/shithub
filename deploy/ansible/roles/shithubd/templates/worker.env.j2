# Sourced by shithubd-worker.service via EnvironmentFile=.

SHITHUB_DATABASE_URL=postgresql://shithub:{{ shithub_db_password }}@127.0.0.1:5432/shithub?sslmode=disable
SHITHUB_REPOS_ROOT={{ shithub_data_root }}/repos
SHITHUB_TMP_ROOT={{ shithub_data_root }}/tmp
SHITHUB_BASE_URL=https://{{ shithub_domain }}
SHITHUB_SITE_NAME=shithub
SHITHUB_EMAIL_FROM={{ shithub_email_from }}
SHITHUB_EMAIL_BACKEND={{ shithub_email_backend }}
SHITHUB_TOTP_KEY={{ shithub_totp_key_b64 }}
SHITHUB_WORKERS=4

{% if shithub_email_backend == "postmark" %}
SHITHUB_POSTMARK_SERVER_TOKEN={{ shithub_postmark_token }}
{% endif %}
